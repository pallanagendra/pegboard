{
  "name": "pegboard",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of small, private, browser-only web tools.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "npm run build && npm run check && npm test",
    "new-tool": "node scripts/new-tool.mjs"
  }
}
