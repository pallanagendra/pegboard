// Cloudflare Workers configuration (static assets only — no server code).
// One Worker per environment:
//   wrangler deploy --env dev         → pegboard-dev.<your-subdomain>.workers.dev
//   wrangler deploy --env staging     → pegboard-staging.<your-subdomain>.workers.dev
//   wrangler deploy --env production  → pegboard.<your-subdomain>.workers.dev (+ your custom domain)
{
  "name": "pegboard",
  // Leave as is; bump it only when you deliberately want newer Workers runtime behavior.
  "compatibility_date": "2026-11-10",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "env": {
    "dev": {
      "workers_dev": true
    },
    "staging": {
      "workers_dev": true
    },
    "production": {
      "name": "pegboard",
      "workers_dev": true
      // When you have a domain on Cloudflare, add it here and redeploy:
      // "routes": [{ "pattern": "pegboard.example.com", "custom_domain": true }]
    }
  }
}
